@using ViewModels.Dashboard;
@using ViewModels.Common.Unit;
@using ViewModels.Common.Department;

@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("Administrator");
    var isApprover = User.IsInRole("Approver");
}
<style>
    *[class^='progress-done-'] {
        height: 100%;
        width: 0;
        opacity: 0;
        background: linear-gradient(to left, #f2709c, #ff9472);
        color: #fff;
        border-radius: 8px;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #fac090;
        box-shadow: 0 3px 3px -5px #f2709c, 0 2px 5px #f2709c;
        transition: 1s ease;
    }

    .department-filter .item_wrap ul li input.active {
        background: #f44b00;
        color: #FFFFFF;
    }

    .department-filter .item_wrap ul li input {
        height: 30px;
        padding: 0px 13px;
        background: #F8F8F8;
        border-radius: 999px;
        border: none;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .department-filter .item_wrap ul li input:hover {
        background: #f44b00;
        color: #FFFFFF;
    }

    .department-filter .item_wrap ul li:last-child {
        border-top-right-radius: 999px;
        border-bottom-right-radius: 999px;
    }

    .department-filter .item_wrap ul li:first-child {
        border-top-left-radius: 999px;
        border-bottom-left-radius: 999px;
    }

    .item_wrap {
        display: flex;
    }

    .department-filter .item_wrap ul li {
        background: #F8F8F8;
        list-style: none;
        padding: 0px;
        margin: 0px;
    }

    .department-filter .item_wrap ul {
        border: 1px solid #E5E5E5;
        display: flex;
        align-items: center;
        padding: 7px 9px;
        border-radius: 999px;
        background-color: #FFFFFF;
        margin: 0px;
    }
</style>
<div class="container-fluid">
    <main>
        @if (isAdmin)
        {
            <h3 class="default-heading">
                Torrance Admin Dashboard
            </h3>
            <div class="department-filter">
                <div class="item_wrap col-md-3">
                    <ul class="choise_button">
                        <li>
                            <input type="button" name="Department" class="search-filters department-filter active"
                                value="All" attr-val="">
                            @foreach (var dept in Model.Departments)
                            {
                                <input type="button" name="Department" class="search-filters department-filter"
                                    value="@dept.Name" attr-val="@dept.Id">
                            }
                        </li>
                    </ul>
                </div>
            </div>
        }
        @if (isApprover)
        {
            <h3 class="default-heading">
                Torrance Approver Dashboard
            </h3>
        }

        <br>
        @if (isAdmin || isApprover)
        {
            <div class="row dashboard-stats-row">
                <div class="col-md-6">
                    <div class="card w-100">
                        <div class="card-body">
                            <div class="content">
                                <h5 class="card-title"> Total TOT's</h5>
                                <p class="card-text" id="total-tot-count">@Model.TotalTotLogs</p>
                            </div>

                            <div class="icon">
                                <span class="tot"><i class="bi-file-text"></i></span>
                            </div>
                        </div>
                    </div>
                </div>

                @*<div class="col-md-4">
                    <div class="card w-100">
                        <div class="card-body">
                            <div class="content">
                                <h5 class="card-title">Total WRR's</h5>
                                <p class="card-text" id="total-wrr-count">@Model.TotalWRRLogs</p>
                            </div>

                            <div class="icon">
                                <span class="tot"><i class="bi-file-text"></i></span>
                            </div>
                        </div>
                    </div>
                </div>*@
                <div class="col-md-6">
                    <div class="card w-100">
                        <div class="card-body">
                            <div class="content">
                                <h5 class="card-title">Total Overrides</h5>
                                <p class="card-text" id="total-or-count">@Model.TotalORLogs</p>
                            </div>

                            <div class="icon">
                                <span class="tot"><i class="bi-file-text"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-6">
                <div class="row">
                    <div class="col-12">
                        <h4 class="mb-4">Time on Tools (TOT)</h4>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        @await Html.PartialAsync("_TOTStatusChart", Model, new ViewDataDictionary(ViewData) { {
                        "ColumnClass", "col-md-12" } })
                        @* @await Html.PartialAsync("_WRRStatusChart", Model, new ViewDataDictionary(ViewData) { {
                                                "ColumnClass", "col-md-6" } }) *@
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        @await Html.PartialAsync("_TOTPieCharts", Model, new ViewDataDictionary(ViewData) { {
                                                "ColumnClass", "col-12" } })
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row">
                    <div class="col-12">
                        <h4 class="mb-4">Override</h4>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        @await Html.PartialAsync("_OverrideStatusChart", Model, new ViewDataDictionary(ViewData) { {
                                                "ColumnClass", "col-md-12" } })
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        @await Html.PartialAsync("_OverridePieCharts", Model, new ViewDataDictionary(ViewData) { {
                                                "ColumnClass", "col-md-12" } })
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
<style>
    .am-chart {
        width: 100%;
        height: 350px;
    }

    .am-pie-chart {
        width: 100%;
        height: 350px;
    }
</style>
<script src="https://cdn.amcharts.com/lib/5/index.js"></script>
<script src="https://cdn.amcharts.com/lib/5/percent.js"></script>
<script src="https://cdn.amcharts.com/lib/5/xy.js"></script>
<script src="https://cdn.amcharts.com/lib/5/themes/Animated.js"></script>

<script src="~/js/custom-scripts/dashboard/am-chart.js"></script>
<script src="~/js/custom-scripts/dashboard/status-chart.js"></script>
<script src="~/js/custom-scripts/dashboard/override-chart.js"></script>
<script src="~/js/custom-scripts/dashboard/tot-chart.js"></script>
<!-- Chart code -->
<script>
    $(function () {
        GetStatusChartData("TOT", "tot-status");
        //GetStatusChartData("WRR", "wrr-status");
        GetStatusChartData("Override", "override-status");
        GetTOTChartData("@isAdmin", "@isApprover");
        GetOverrideChartData();

        function updateDashboardStats(queryString) {
            $.ajax({
                url: '@Url.Action("GetDashboardStats", "Home")',
                type: 'GET',
                data: queryString,
                success: function (response) {
                    $('#total-tot-count').text(response.totalTotLogs);
                    //$('#total-wrr-count').text(response.totalWRRLogs);
                    $('#total-or-count').text(response.totalORLogs);
                }
            });
        }

        $(document).on("click", ".search-filters.department-filter", function () {
            // Remove active class from all buttons
            $(".department-filter").removeClass("active");
            // Add active class to clicked button
            $(this).addClass("active");

            var departmentId = $(this).attr("attr-val");
            var search = {
                "Department.Id": departmentId ? parseInt(departmentId) : null
            };

            // Convert search object to query string format
            var queryString = $.param(search);

            // Update dashboard stats
            updateDashboardStats(queryString);

            GetStatusChartData("TOT", "tot-status", queryString);
            //GetStatusChartData("WRR", "wrr-status", queryString);
            GetStatusChartData("Override", "override-status", queryString);
            GetTOTChartData("@isAdmin", "@isApprover", queryString);
            GetOverrideChartData(queryString);
        });
    })</script>
